{
  "name": "Portfolio - Automated Lead Management System",
  "active": false,
  "nodes": [
    {
      "id": "lead-webhook",
      "name": "Lead Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "portfolio-lead-management-v1",
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "lead-processor",
      "name": "Normalize Validate & Sync CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8788/leads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "webhook-response",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        800,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      }
    },
    {
      "id": "setup-note",
      "name": "Setup and Contract Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        80
      ],
      "parameters": {
        "width": 780,
        "height": 180,
        "content": "## Automated Lead Management System (v1.0)\n1. Webhook Header Auth: `X-Webhook-Key` (stored in n8n Credential Manager).\n2. Processor Header Auth: `X-Service-Key` (stored in n8n Credential Manager).\n3. Lifecycle statuses tracked: `masuk` -> `processing` -> `sent` | `timeout` | `error`.\n4. Deduplicates by `lead_id` and normalized `email`; returns 202 (accepted), 200 (duplicate), 409 (conflict), or 422 (invalid email/schema)."
      }
    }
  ],
  "connections": {
    "Lead Intake Webhook": {
      "main": [
        [
          {
            "node": "Normalize Validate & Sync CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Validate & Sync CRM": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
  "tags": []
}
